#importonce
#import "m2_abi.inc"
// M3 internal state. PCB padding is not part of the bytecode ABI.
.const SCHED_BASE = $fe00
.const SCHED_FRAME = SCHED_BASE
.const SCHED_READY = SCHED_BASE+4
.const SCHED_COUNT = SCHED_BASE+8
.const SCHED_CURRENT = SCHED_BASE+9
.const SCHED_DUE = SCHED_BASE+10 // 0 VM, 1 native; retained across video windows.
.const SCHED_JOB_CURSOR = SCHED_BASE+11
.const SCHED_APPS = SCHED_BASE+12
.const SCHED_CONTROL = SCHED_BASE+13 // 1 run, 0 diagnostic pause at a boundary.
.const SCHED_CANCEL = SCHED_BASE+14 // 0 none, otherwise slot+1.
.const SCHED_CANCELLED = SCHED_BASE+15
.const SCHED_SWITCHES = SCHED_BASE+16 // Four u16 owner counters.
.const SCHED_NATIVE_TICKS = SCHED_BASE+24 // Four u32 counters.
.const SCHED_DMA_BYTES = SCHED_BASE+40 // Four u32 counters.
.const SCHED_WINDOWS = SCHED_BASE+56 // Four diagnostic-only live handle u16s.
.const SCHED_VM_PHASES = SCHED_BASE+64 // u32, completed ordinary phases.
.const SCHED_NATIVE_PHASES = SCHED_BASE+68 // u32, actually admitted chunks.
.const SCHED_COMPLETIONS = SCHED_BASE+72 // Four u16 accepted completions.
.const SCHED_TIMER_START = SCHED_BASE+80
.const SCHED_TIMER_END = SCHED_BASE+82
.const SCHED_NATIVE_MAX = SCHED_BASE+84 // u16 PHI2 ticks, includes collection.
.const SCHED_TEMP = SCHED_BASE+86 // Private scheduler temporary bytes.
.const SCHED_DISPATCH_MASK = SCHED_BASE+93 // First dispatch after activation.
.const SCHED_WOKE = SCHED_BASE+96 // Four last-wake frame u32s.
.const SCHED_FIRST_RUN = SCHED_BASE+112 // Four last-run frame u32s.
.const SCHED_GLOBAL_BYTES = 128
.const SP_STATE = 0
.const SP_REFILL = 1
.const SP_JOB = 2
.const SP_PHASE = 3
.const SP_DST = 4
.const SP_SRC = 7
.const SP_LEFT = 10
.const SP_VALUE = 13
.const SP_GENERATION = 16
.const SP_STARTED = 18
.const SP_TIMEOUT = 22
.const SP_NATIVE_BYTES = 24
.const SP_NATIVE_CHUNKS = 28
.const PROC_STOPPED = 0
.const PROC_RUNNABLE = 1
.const PROC_WAIT_REU = 2
.const PROC_WAIT_JOB = 3
.const PROC_SLEEPING = 4
.const PROC_FAULTED = 5
.const PROC_WAIT_EVENT = 6
.const JOB_NONE = 0
.const JOB_FILL = 1
.const JOB_COPY = 2
.const JOB_COPY_BACKWARD = 3
.const JOB_SLEEP = 4
.const JOB_EVENT = 5
.label sched_ptr = $80
.label sched_value = $82 // Four-byte unsigned arithmetic temporary.
.label sched_address = $86 // Three-byte address temporary.
.label sched_index = $89
.label sched_kind = $8a
.label sched_width = $8b
.label sched_phase = $8c
.label sched_bytes = $8d // Three-byte scalar temporary.
.label sched_extra = $90
